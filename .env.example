# Resend — email delivery for the contact form
# Get your key at: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloudflare Turnstile — server-side secret (never expose to browser)
# Get your keys at: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=0xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloudflare Turnstile — client-side site key (safe to expose, prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SEO Dashboard — external CMS that powers the Articles section (Wagtail API v2)
# Base URL of the seodashboard instance, no trailing slash (this is the API root, not the /admin/ UI)
SEODASHBOARD_API_URL=https://seodashboard.example.com
# This site's slug in the seodashboard multi-site setup (used to find its home page)
SEODASHBOARD_SITE_SLUG=rowad-alqimma
# Slug of the section nested under each locale section ("en"/"ar") that holds articles
SEODASHBOARD_ARTICLES_SECTION_SLUG=news
